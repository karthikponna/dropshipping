# DropShipping — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so
# never put real values here. The app boots with these blank: Supabase-backed
# features degrade to a notice and generation reports a missing key.

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Both of these are safe in the browser, and
# they are the only two Supabase values the app needs: every query runs as the
# signed-in user through RLS, so there is no service-role key to leak.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Newer projects show a publishable key (sb_publishable_…); older ones a legacy
# anon JWT (eyJ…). Set whichever name matches the key you copied — the app reads
# PUBLISHABLE first and falls back to ANON.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Anthropic ─────────────────────────────────────────────────────────────
# Fallback key used when the signed-in user has not saved their own in
# /dashboard/settings. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Secret encryption ─────────────────────────────────────────────────────
# 32 bytes for AES-256-GCM, used to encrypt each user's stored Anthropic key.
# Generate with: openssl rand -hex 32
# Changing this makes every already-stored key undecryptable.
APP_ENCRYPTION_KEY=

# ── HydraDB (memory graph) ────────────────────────────────────────────────
# The graph that lets a product page inherit the landing page's design, and lets
# a new chat recall "the shop I built yesterday". Entirely optional: leave these
# blank and generation works as it always did, minus the memory.
#
# Start a local node with `npm run hydra:up`; it writes its own auth token to
# ./.hydradb/auth-token, and the defaults below match what that compose file
# serves. Verify the connection with `npm run hydra:probe`.
HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_TOKEN=local-development-token-32-bytes
HYDRADB_GRAPH=default
HYDRADB_NAMESPACE=default
HYDRADB_CELL_ID=cell-0
# Per-query ceiling in ms. The graph must never be what makes a generation slow.
# HYDRADB_TIMEOUT_MS=4000

# DropShipping — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not, so
# never put real values here. The app boots with these blank: Supabase-backed
# features degrade to a notice and generation reports a missing key.

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API. Both of these are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose it to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────
# Fallback key used when the signed-in user has not saved their own in
# /dashboard/settings. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Secret encryption ─────────────────────────────────────────────────────
# 32 bytes for AES-256-GCM, used to encrypt each user's stored Anthropic key.
# Generate with: openssl rand -hex 32
# Changing this makes every already-stored key undecryptable.
APP_ENCRYPTION_KEY=

{
  "name": "dropshipping",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ai && npm run test:preview && npm run test:export",
    "test:ai": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON lib/ai/run-tests.mjs",
    "test:preview": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON lib/preview/run-tests.mjs",
    "test:export": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON lib/export/project-zip.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jszip": "^3.10.1",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
